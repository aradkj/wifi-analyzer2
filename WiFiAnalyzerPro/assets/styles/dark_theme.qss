/* WiFi Analyzer Pro - Dark Modern Theme */

QMainWindow {
    background-color: #0A0E17;
}

QWidget#CentralWidget {
    background-color: #0A0E17;
}

/* Global Typography & Default Colors */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica Neue", Arial, sans-serif;
    color: #E2E8F0;
}

/* Tab Bar Styling */
QTabWidget {
    background-color: #0F141C;
    border: none;
}

QTabWidget::pane {
    border: 1px solid #232E40;
    border-radius: 8px;
    background-color: #0F141C;
    top: -1px;
}

QTabBar::tab {
    background-color: #141D2B;
    color: #A0AEC0;
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #1E293B;
    border-bottom: none;
    font-size: 12px;
    font-weight: 700;
}

QTabBar::tab:selected {
    background-color: #0F141C;
    color: #00D2FF;
    border-top: 3px solid #00D2FF;
    border-left: 1px solid #232E40;
    border-right: 1px solid #232E40;
    font-weight: 800;
}

QTabBar::tab:hover:!selected {
    background-color: #1A2436;
    color: #FFFFFF;
}

/* Primary SCAN Button */
QPushButton#ScanButton {
    background-color: #00D2FF;
    color: #060D17;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.8px;
    border: 1px solid #38BDF8;
    border-radius: 6px;
    padding: 7px 24px;
    min-height: 22px;
}

QPushButton#ScanButton:hover {
    background-color: #38E1FF;
    color: #000000;
    border-color: #7DD3FC;
}

QPushButton#ScanButton:pressed {
    background-color: #0284C7;
    color: #FFFFFF;
}

QPushButton#ScanButton:disabled {
    background-color: #11283D;
    color: #38BDF8;
    border: 1px solid #0369A1;
}

/* Standard Buttons */
QPushButton {
    background-color: #1E2838;
    color: #FFFFFF;
    border: 1px solid #2F3E55;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #28374E;
    color: #FFFFFF;
    border-color: #00D2FF;
}

QPushButton:pressed {
    background-color: #141C28;
}

QPushButton:disabled {
    background-color: #121820;
    color: #475569;
    border-color: #1A2330;
}

/* ComboBox */
QComboBox {
    background-color: #1E2838;
    color: #FFFFFF;
    border: 1px solid #2F3E55;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    min-width: 110px;
}

QComboBox:hover {
    border-color: #00D2FF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161D27;
    color: #E2E8F0;
    border: 1px solid #232E40;
    selection-background-color: #1E3A5F;
    selection-color: #FFFFFF;
    outline: none;
}

/* CheckBox */
QCheckBox {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 600;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2F3E55;
    border-radius: 4px;
    background-color: #1E2838;
}

QCheckBox::indicator:hover {
    border-color: #00D2FF;
}

QCheckBox::indicator:checked {
    background-color: #00D2FF;
    border-color: #00D2FF;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0B0F17;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #232E40;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #00D2FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0B0F17;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #232E40;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #00D2FF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #070B11;
    color: #8E9FB5;
    border-top: 1px solid #1A2433;
    font-size: 11px;
    padding: 5px 10px;
}

/* ToolTip */
QToolTip {
    background-color: #161D27;
    color: #FFFFFF;
    border: 1px solid #28374D;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px;
}
